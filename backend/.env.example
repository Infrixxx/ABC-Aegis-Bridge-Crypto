# ─────────────────────────────────────────────────────────────────────────────
# Aegis Bridge Crypto (ABC) — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Or run `python e2e_test.py` inside backend/ to auto-fund Testnet wallets.
# ─────────────────────────────────────────────────────────────────────────────

# ── XRPL Testnet Wallets (Auto-provisioned by e2e_test.py) ────────────────────
TREASURY_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TREASURY_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCHANT_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCHANT_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXX

XRPL_JSON_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_EXPLORER_BASE=https://testnet.xrpl.org/transactions

# ── Simulation Flag (Keep 0 in production/judging so real errors surface) ─────
ALLOW_SIMULATION=0

# ── Optional RLUSD Stablecoin (Leave RLUSD_ISSUER empty to settle in XRP) ─────
RLUSD_CURRENCY=RLUSD
RLUSD_ISSUER=

# ── FX Rate & Auth ────────────────────────────────────────────────────────────
API_NINJAS_KEY=
FX_LOCK_SECONDS=60
FX_FALLBACK_RATE=0.055
AUTH_SECRET_KEY=abc_hackathon_secure_jwt_secret_key_2026

# ── Africa's Talking (Sandbox) ────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=