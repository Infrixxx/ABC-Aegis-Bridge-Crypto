# ─────────────────────────────────────────────────────────────────────────────
# Aegis Bridge Crypto (ABC) — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value below.
#   3. NEVER commit your real .env file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── FX Rate Provider ──────────────────────────────────────────────────────────
# Get a free key at https://api-ninjas.com/
API_NINJAS_KEY=your_api_ninjas_key_here

# ── XRPL Testnet Treasury ─────────────────────────────────────────────────────
# Generate a funded testnet wallet at https://xrpl.org/xrp-testnet-faucet.html
TREASURY_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TREASURY_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# XRPL node — use the public Testnet WebSocket
XRPL_NODE_URL=wss://s.altnet.rippletest.net:51233

# ── Africa's Talking ──────────────────────────────────────────────────────────
# Sign up at https://account.africastalking.com/
# Use "sandbox" for username during development
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here

# ── AI / LangGraph ────────────────────────────────────────────────────────────
# Google Gemini (default). Get a key at https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
# How long (seconds) the FX rate is locked per order. Default: 60
FX_LOCK_SECONDS=60
